.DS_Store
node_modules/
.claude/settings.local.json
_site/
# Copies of the songs in music/, which library/music.js writes. Git keeps music/ and the list of songs.
ui-ideas/audio/*.mp3
ui-ideas/audio/*.js
!ui-ideas/audio/songs.js
# SwiftUI Quest, read by library/quest.js. The repo is public, and this is another site's course, so git keeps only the list
# of which pieces are implementation details, which has no text from the course.
sources/*/*
!sources/*/implementation.json
